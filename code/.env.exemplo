# Copie para .env.local. Nunca commite as credenciais reais.
# MongoDB Atlas: inclua o nome do banco na URI. Escape caracteres especiais da senha.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/construtor_curriculos?retryWrites=true&w=majority
# URL canônica, sem /api no final. Ajuste também no deploy.
AUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# Só habilite em uma hospedagem com proxy confiável que normalize os headers.
# AUTH_TRUST_HOST=true
# Google OAuth: aplicativo Web
# Callback local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth App
# Callback local: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
